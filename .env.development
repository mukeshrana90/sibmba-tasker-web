# Local: use same-origin /api + /public + /socket.io (see src/setupProxy.js) so HTTPS:3001 works.
# Backend target for the proxy (API + Engine.IO / Socket.IO):
REACT_APP_PROXY_TARGET=http://192.168.1.39:4041

REACT_APP_API_BASE_URL=/api
REACT_APP_API_URL=/public
# "/" = same-origin socket base; CRA must proxy ONLY /socket.io → API (never /ws — that is webpack HMR)
REACT_APP_API_URLL=/

# Mobile geolocation on real phones requires HTTPS (http://192.168.x.x is blocked).
# Use https://192.168.1.39:3001 on phones and accept the certificate warning once.
HTTPS=true
HOST=0.0.0.0

